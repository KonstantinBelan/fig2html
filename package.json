{
    "name": "figmatik",
    "version": "1.5.4",
    "description": "Figma (.fig) to clean responsive HTML/CSS decompiler and bidirectional HTML-to-Figma compiler",
    "license": "MIT",
    "author": "Konstantin Belan <kosbelan@yandex.ru>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KonstantinBelan/figmatik.git"
    },
    "bugs": {
        "url": "https://github.com/KonstantinBelan/figmatik/issues"
    },
    "homepage": "https://github.com/KonstantinBelan/figmatik#readme",
    "type": "module",
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./package.json": "./package.json"
    },
    "bin": {
        "figmatik": "cli.js",
        "fig2html": "cli-reverse.js",
        "fig-to-html": "cli-reverse.js",
        "html-to-fig": "cli.js",
        "html2fig": "cli.js"
    },
    "files": [
        "cli.js",
        "cli-reverse.js",
        "index.js",
        "src",
        "templates",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "start": "node cli-reverse.js",
        "build": "node index.js",
        "test": "node test/runner.js"
    },
    "keywords": [
        "figmatik",
        "fig2html",
        "figma",
        "figma-to-html",
        "figma-decompiler",
        "fig-to-html",
        "html-to-fig",
        "html2fig",
        "fig",
        "kiwi",
        "converter",
        "auto-layout",
        "flexbox",
        "responsive",
        "css-grid",
        "sharp",
        "cli"
    ],
    "dependencies": {
        "@open-pencil/kiwi": "^0.16.0",
        "@resvg/resvg-js": "^2.6.2",
        "adm-zip": "^0.6.1",
        "fzstd": "^0.1.1",
        "jsdom": "^24.0.0",
        "kiwi-schema": "^0.5.0",
        "sharp": "^0.35.5",
        "zstd-codec": "^0.1.5"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
